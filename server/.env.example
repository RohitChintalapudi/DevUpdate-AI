# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/devupdate-ai

# Use a long, random value in production (openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cookie settings. Use "lax" so the session cookie survives the GitHub redirect.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# GitHub OAuth App (keep these values on the server only)
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# This must exactly match the OAuth App's Authorization callback URL.
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# OAuth scopes. "repo" is required to read private repositories; GitHub OAuth
# Apps do not support read-only repository scopes.
GITHUB_OAUTH_SCOPES=repo read:user user:email read:org

# 32-byte hex key used to encrypt GitHub OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Phase 3 — update intelligence
# Official OSV endpoint. Override only for a trusted proxy.
OSV_API_BASE_URL=https://api.osv.dev
# Registry response cache lifetime in milliseconds (process-local cache).
UPDATE_REGISTRY_CACHE_TTL_MS=600000
# How often a dependency should be rechecked in milliseconds.
UPDATE_CHECK_INTERVAL_MS=21600000
# Registry/advisory HTTP settings.
UPDATE_HTTP_TIMEOUT_MS=12000
UPDATE_HTTP_RETRIES=2
UPDATE_HTTP_BACKOFF_MS=350
# Controlled concurrency for dependency checks and update jobs.
UPDATE_MAX_CONCURRENCY=5
UPDATE_MAX_CONCURRENT_JOBS=2

# Phase 4 — AI dependency intelligence (server-side secrets only)
# Groq supplies LLM inference. gpt-oss models support native strict JSON Schema output.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=60000

# Firecrawl retrieves official documentation; all content is treated as untrusted.
FIRECRAWL_API_KEY=
AI_MAX_RESEARCH_SOURCES=5
AI_FIRECRAWL_LIMIT_PER_MINUTE=20
AI_FIRECRAWL_TIMEOUT_MS=30000
AI_RESEARCH_CACHE_TTL_MS=1800000

# Pinecone stores real embeddings and enforces per-user namespaces.
VECTOR_STORE_TYPE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=devupdate-ai
PINECONE_NAMESPACE_PREFIX=devupdate
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# AI job limits and API rate limiting.
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_JOBS_PER_USER=5
AI_MAX_JOBS_PER_REPOSITORY=2
AI_REPOSITORY_MAX_DEPENDENCIES=10
AI_API_RATE_LIMIT=300

# Phase 5 — persistent memory, feedback, history, reports and notifications
# Memento (mementoagi.com) is a BEST-EFFORT mirror. MongoDB remains authoritative
# for access control, metadata, retention and UI state. Leave the API key blank
# to run in explicit MONGODB_FALLBACK mode; remote failures are always visible.
MEMENTO_API_KEY=
MEMENTO_MCP_URL=https://api.mementoagi.com/mcp
MEMENTO_TIMEOUT_MS=12000
# Hard cap on stored memories per repository.
MEMORY_MAX_PER_REPOSITORY=2000
# Requests per 15 minutes for all /api/memory, /api/feedback, /api/history,
# /api/reports and /api/notifications endpoints.
PHASE5_API_RATE_LIMIT=300

