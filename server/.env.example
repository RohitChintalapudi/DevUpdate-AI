# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/devupdate-ai

# Use a long, random value in production (openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cookie settings. Use "lax" so the session cookie survives the GitHub redirect.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# GitHub App (keep these values on the server only)
# Find APP_ID and CLIENT_ID in the GitHub App settings page.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the PEM private key as a single line with \n between lines, or as a
# quoted multi-line value. Never commit this value.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The URL slug from github.com/apps/<slug>
GITHUB_APP_SLUG=
